{
  "name": "student-monitor",
  "version": "0.0.0",
  "private": true,
  "description": "Coaching platform for Turkish exam preparation (YKS / LGS)",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
